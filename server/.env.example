# MongoDB — use Atlas connection string in production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_complaints?appName=Cluster0

# Server port
PORT=4000

# Cloudinary — get from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Comma-separated allowed frontend origins (no spaces)
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Production: add your Vercel URL here e.g. https://your-app.vercel.app
